# Secrets. Nothing in these patterns ever belongs in a commit.
.env
.env.*
*.key
*.pem
*.keystore
.keystore/
recovery_file*.dat
secrets/

# Runtime state. The two chain anchor addresses are public contract addresses the image copies (Dockerfile):
# tracked so an uploader that honours this file (railway up) still ships them.
runtime/*
!runtime/arc_anchor.addr
!runtime/arbitrum-sepolia_anchor.addr
# Railway's project link (scripts/deploy_railway.sh); ids only, but local state.
.railway/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# Rust build output (root workspace and scripts/research probes)
target/

# Browser automation logs (local console output)
.playwright-mcp/

# Audit packs (scripts/audit_pack.py): an account's ledger and evidence, account data, never committed.
/audit-pack/

# Markdown (founder, 2026-10-15): the root README.md is the only Markdown file
# that goes to GitHub for now. Docs, plans, notes, CLAUDE.md, RESUME.md and every
# other *.md stay local until the founder says otherwise.
*.md
!/README.md

# The console (Next.js): dependencies and build output are made, not committed.
apps/console/node_modules/
apps/console/.next/
apps/console/out/

# Claude Code local state
.claude/*.lock

# Local only (founder, 2026-10-16): notes, sources and tool state never go to GitHub.
/docs/
/archive/
.claude/
.DS_Store
nohup.out
*.new
# Foundry run from the repo root by mistake, and per-crate leftovers from `cargo new`.
/out/
/cache/
crates/*/Cargo.lock

# The SDK README is part of the package agents install, not a research note (docs/115, S18).
!/apps/sdk/README.md
!/DETAILS.md
